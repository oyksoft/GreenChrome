<Window x:Class="GreenChrome.UI.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Width="440" Height="400"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True">

    <!-- 遮罩：盖住父窗口 -->
    <Grid Background="#66000000">
        <Border Background="{StaticResource ColCard}" CornerRadius="14"
                Margin="0" Padding="22,20,22,20"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Width="420">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.20" Color="#000000"/>
            </Border.Effect>

            <StackPanel>
                <!-- 标题行：圆点 + 标题 -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <Ellipse x:Name="TitleDot" Width="8" Height="8" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TitleText" Margin="10,0,0,0" FontSize="12.5" FontWeight="Medium"
                               VerticalAlignment="Center" Foreground="{StaticResource ColText}"/>
                </StackPanel>

                <!-- 正文 -->
                <TextBlock x:Name="MessageText" FontSize="13.5" TextWrapping="Wrap"
                           Foreground="{StaticResource ColText}" LineHeight="22"/>

                <!-- 按钮区 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                    <Button x:Name="BtnCancel" Content="取消" Style="{StaticResource SecondaryButton}"
                            MinWidth="110" Margin="0,0,12,0" Click="BtnCancel_Click"/>
                    <Button x:Name="BtnOk" Content="确定" Style="{StaticResource PrimaryButton}"
                            MinWidth="110" Click="BtnOk_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
