<Window x:Class="GreenChrome.UI.DirectoryPicker"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择绿色版 Chrome 所在目录"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Width="580" Height="500"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True">

    <Grid Background="#66000000">
        <Border Background="{StaticResource ColCard}" CornerRadius="14"
                Padding="22,20" Width="560" Height="470"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="2" Opacity="0.18" Color="#000000"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 标题 -->
                <TextBlock Grid.Row="0" Text="选择绿色版 Chrome 所在目录"
                           FontSize="12.5" FontWeight="Medium"
                           Foreground="{StaticResource ColTextMuted}" Margin="0,0,0,10"/>

                <!-- 路径栏 -->
                <Grid Grid.Row="1" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" x:Name="BtnUp" Content="↑ 上级" Height="30" MinWidth="72"
                            Padding="12,0" FontSize="12.5" Style="{StaticResource SecondaryButton}"
                            Click="BtnUp_Click"/>
                    <TextBlock Grid.Column="1" x:Name="PathText" Margin="12,0,0,0" VerticalAlignment="Center"
                               FontSize="13.5" Foreground="{StaticResource ColText}"
                               TextTrimming="CharacterEllipsis"/>
                </Grid>

                <!-- 列表 -->
                <Border Grid.Row="2" Background="#FAFBFC" CornerRadius="8"
                        BorderBrush="{StaticResource ColBorder}" BorderThickness="1">
                    <ListBox x:Name="EntryList" BorderThickness="0" Background="Transparent"
                             Margin="6"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             SelectionChanged="EntryList_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Height" Value="34"/>
                                <Setter Property="Margin" Value="0,0,0,2"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="bd" Background="Transparent" CornerRadius="6">
                                                <ContentPresenter VerticalAlignment="Center" Margin="10,0"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#F0F2F5"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource ColAccentBg}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <!-- 文件夹图标 -->
                                    <Canvas Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <Rectangle Canvas.Left="3" Canvas.Top="6" Width="14" Height="11"
                                                   RadiusX="1.5" RadiusY="1.5" Fill="#9098A4"/>
                                        <Rectangle Canvas.Left="3" Canvas.Top="5" Width="6" Height="3"
                                                   RadiusX="1" RadiusY="1" Fill="#9098A4"/>
                                    </Canvas>
                                    <TextBlock Text="{Binding Display}" FontSize="13.5"
                                               VerticalAlignment="Center" Foreground="{StaticResource ColText}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <!-- 按钮 -->
                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <Button x:Name="BtnCancel" Content="取消" Style="{StaticResource SecondaryButton}"
                            MinWidth="110" Margin="0,0,12,0" Click="BtnCancel_Click"/>
                    <Button x:Name="BtnOk" Content="选择此目录" Style="{StaticResource PrimaryButton}"
                            MinWidth="130" Click="BtnOk_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
