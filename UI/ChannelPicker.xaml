<Window x:Class="GreenChrome.UI.ChannelPicker"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Width="440" Height="400"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True">

    <Grid Background="#66000000">
        <Border Background="{StaticResource ColCard}" CornerRadius="14"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Width="420" Padding="22,20,22,18">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.20" Color="#000000"/>
            </Border.Effect>

            <StackPanel>
                <!-- 标题行 -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                             Fill="{StaticResource ColAccent}"/>
                    <TextBlock Margin="10,0,0,0" FontSize="12.5" FontWeight="Medium"
                               VerticalAlignment="Center" Foreground="{StaticResource ColText}"
                               Text="选择要制作的通道"/>
                </StackPanel>

                <TextBlock FontSize="12.5" TextWrapping="Wrap" LineHeight="20"
                           Foreground="{StaticResource ColTextMuted}"
                           Margin="0,0,0,14"
                           Text="将下载该通道的官方离线包，制作成一套新的绿色版 Chrome。"/>

                <!-- 通道行在代码里生成 -->
                <StackPanel x:Name="RowHost"/>

                <!-- 按钮区 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                    <Button x:Name="BtnCancel" Content="取消" Style="{StaticResource SecondaryButton}"
                            MinWidth="110" Margin="0,0,12,0" Click="BtnCancel_Click"/>
                    <Button x:Name="BtnOk" Content="下一步" Style="{StaticResource PrimaryButton}"
                            MinWidth="110" Click="BtnOk_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
