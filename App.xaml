<Application x:Class="GreenChrome.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>

        <!-- ===== 配色 ===== -->
        <SolidColorBrush x:Key="ColBg"          Color="#F4F5F7"/>
        <SolidColorBrush x:Key="ColCard"        Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ColBorder"      Color="#E5E7EB"/>
        <SolidColorBrush x:Key="ColText"        Color="#1A1D23"/>
        <SolidColorBrush x:Key="ColTextMuted"   Color="#6B7280"/>
        <!-- 键名专用：比 muted 深一档，与右侧的值视觉重量匹配（否则看着会“小一号”） -->
        <SolidColorBrush x:Key="ColTextLabel"   Color="#454B57"/>
        <SolidColorBrush x:Key="ColAccent"      Color="#16A34A"/>
        <SolidColorBrush x:Key="ColAccentBg"    Color="#E7F6EC"/>
        <SolidColorBrush x:Key="ColDanger"      Color="#C0392B"/>
        <SolidColorBrush x:Key="ColDangerBg"    Color="#FFF5F5"/>
        <SolidColorBrush x:Key="ColDangerBorder" Color="#F0C4C4"/>

        <!-- ===== 按钮图标（矢量，24x24 视口）===== -->
        <!-- 刷新 / 循环箭头：检查更新 -->
        <Geometry x:Key="IconRefresh">M 17.65,6.35 C 16.2,4.9 14.21,4 12,4 c -4.42,0 -7.99,3.58 -7.99,8 s 3.57,8 7.99,8 c 3.73,0 6.84,-2.55 7.73,-6 h -2.08 c -0.82,2.33 -3.04,4 -5.65,4 c -3.31,0 -6,-2.69 -6,-6 s 2.69,-6 6,-6 c 1.66,0 3.14,0.69 4.22,1.78 L 13,11 h 7 V 4 l -2.35,2.35 z</Geometry>
        <!-- 上下双箭头：立即更新 -->
        <Geometry x:Key="IconUpdate">M 12,4 L 12,1 L 8,5 l 4,4 L 12,6 c 3.31,0 6,2.69 6,6 c 0,1.01 -0.25,1.97 -0.7,2.8 l 1.46,1.46 C 19.54,15.03 20,13.57 20,12 C 20,7.58 16.42,4 12,4 z M 12,18 c -3.31,0 -6,-2.69 -6,-6 c 0,-1.01 0.25,-1.97 0.7,-2.8 L 5.24,7.74 C 4.46,9.17 4,10.63 4,12 c 0,4.42 3.58,8 8,8 v 3 l 4,-4 l -4,-4 v 3 z</Geometry>

        <!-- ===== 字体 ===== -->
        <FontFamily x:Key="UiFont">Microsoft YaHei UI, Microsoft YaHei, SimHei</FontFamily>

        <!-- ===== 卡片样式 ===== -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource ColCard}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ColBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="20"/>
        </Style>

        <!-- ===== 卡片标题 ===== -->
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{StaticResource ColTextMuted}"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <!-- ===== 主按钮（绿底白字）===== -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource ColAccent}"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="Padding" Value="32,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#128A3E"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#0F7434"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#D1D5DB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 次级按钮（白底描边）===== -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{StaticResource ColText}"/>
            <Setter Property="Background" Value="{StaticResource ColCard}"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="Padding" Value="32,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource ColBorder}" BorderThickness="1"
                                CornerRadius="8" SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F7F8FA"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#EEF0F3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 危险按钮（浅红底红字，hover 变深红底白字）===== -->
        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{StaticResource ColDanger}"/>
            <Setter Property="Background" Value="{StaticResource ColDangerBg}"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="Padding" Value="32,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource ColDangerBorder}" BorderThickness="1"
                                CornerRadius="8" SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="cp" Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource ColDanger}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource ColDanger}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 左侧导航项 ===== -->
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource ColText}"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="10" SnapsToDevicePixels="True">
                            <Grid Margin="16,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0" Content="{TemplateBinding Tag}"
                                                  Width="20" Height="20" VerticalAlignment="Center"/>
                                <ContentPresenter Grid.Column="1" Margin="14,0,0,0"
                                                  Content="{TemplateBinding Content}"
                                                  VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F5F6F8"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource ColAccentBg}"/>
                                <Setter Property="Foreground" Value="{StaticResource ColAccent}"/>
                                <Setter Property="FontWeight" Value="Medium"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 通道分段控件（segmented control）的单个分段 -->
        <Style x:Key="ChannelChip" TargetType="RadioButton">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource ColTextMuted}"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinWidth" Value="56"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="Transparent"
                                BorderBrush="Transparent" BorderThickness="1"
                                CornerRadius="6" SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource ColText}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource ColCard}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource ColBorder}"/>
                                <Setter Property="Foreground" Value="{StaticResource ColText}"/>
                                <Setter Property="FontWeight" Value="Medium"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="Transparent"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 键值行（左键右值）===== -->
        <Style x:Key="KvKey" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Foreground" Value="{StaticResource ColTextLabel}"/>
            <Setter Property="Width" Value="78"/>
            <Setter Property="LineHeight" Value="30"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="KvVal" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Foreground" Value="{StaticResource ColText}"/>
            <Setter Property="LineHeight" Value="30"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ===== 配置说明（关于页）===== -->
        <Style x:Key="ConfKey" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas, Microsoft YaHei UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource ColText}"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>

        <Style x:Key="ConfDesc" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource ColTextMuted}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="20"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>

        <Style x:Key="ConfHead" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource ColTextMuted}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

    </Application.Resources>
</Application>
