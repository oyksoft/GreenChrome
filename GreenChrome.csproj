<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- .NET Framework 4.8.1：Win10 1903+ / Win11 系统自带运行时，exe 体积极小 -->
    <TargetFramework>net481</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>GreenChrome</AssemblyName>
    <RootNamespace>GreenChrome</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>x64</PlatformTarget>
    <DebugType>none</DebugType>
    <!-- 体积优化 -->
    <Optimize>true</Optimize>
    <!-- 单文件 exe 用不上 bindingRedirect（嵌入的 dll 不走重定向），关掉自动生成 app.config -->
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>false</GenerateBindingRedirectsOutputType>
  </PropertyGroup>

  <ItemGroup>
    <!-- 排除工具目录（独立项目） -->
    <Compile Remove="tools\**" />
    <None Remove="tools\**" />
    <Page Remove="tools\**" />
    <ApplicationDefinition Remove="tools\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- 系统原生「选择文件夹」对话框（Vista IFileDialog，自带新建文件夹） -->
    <Reference Include="System.Windows.Forms" />
    <!-- Costura 的启动初始化接口（仅编译期引用，不复制到输出目录） -->
    <Reference Include="Costura">
      <HintPath>$(NuGetPackageRoot)costura.fody\6.2.0\lib\netstandard2.0\Costura.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- 让 dotnet SDK 能编译 net48x 项目（无需安装 Developer Pack） -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
    <!-- 纯托管 7z 解压，可编译进 exe，无需外部 7z.dll -->
    <PackageReference Include="SharpCompress" Version="0.38.0" />
    <!-- JSON 解析（.NET Framework 无内置通用 JSON 库） -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <!-- 把依赖 dll 嵌入 exe，打包成单文件（构建后自动生效） -->
    <PackageReference Include="Costura.Fody" Version="6.2.0" PrivateAssets="all" />
  </ItemGroup>

  <!-- 单文件 exe 不需要 app.config：supportedRuntime 与 bindingRedirect 都用不上 -->
  <Target Name="RemoveAppConfig" AfterTargets="Build">
    <Delete Files="$(TargetDir)$(TargetFileName).config" ContinueOnError="true" />
  </Target>

</Project>
