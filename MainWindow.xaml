<Window x:Class="GreenChrome.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GreenChrome - 绿色版 Chrome 工具"
        Width="1060" Height="700"
        MinWidth="1060" MinHeight="700"
        MaxWidth="1060" MaxHeight="700"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource ColBg}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= 左侧导航 ================= -->
        <Border Grid.Column="0" Background="{StaticResource ColCard}"
                BorderBrush="{StaticResource ColBorder}" BorderThickness="0,0,1,0">
            <Grid Margin="16,28,16,28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 品牌 -->
                <StackPanel Grid.Row="0" Margin="4,0,0,20">
                    <TextBlock Text="GreenChrome" FontSize="17" FontWeight="Bold"
                               Foreground="{StaticResource ColText}"/>
                    <TextBlock Text="绿色版 Chrome 管理器" FontSize="12.5" Margin="0,6,0,0"
                               Foreground="{StaticResource ColTextMuted}"/>
                </StackPanel>

                <!-- 导航项 -->
                <StackPanel Grid.Row="1">
                    <RadioButton x:Name="NavDashboard" Style="{StaticResource NavItem}"
                                 Content="仪表盘" GroupName="Nav" IsChecked="True"
                                 Checked="NavDashboard_Checked">
                        <RadioButton.Tag>
                            <Canvas Width="20" Height="20">
                                <Rectangle Canvas.Left="3" Canvas.Top="3" Width="6" Height="6" RadiusX="1.5" RadiusY="1.5" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                <Rectangle Canvas.Left="11" Canvas.Top="3" Width="6" Height="6" RadiusX="1.5" RadiusY="1.5" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                <Rectangle Canvas.Left="3" Canvas.Top="11" Width="6" Height="6" RadiusX="1.5" RadiusY="1.5" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                <Rectangle Canvas.Left="11" Canvas.Top="11" Width="6" Height="6" RadiusX="1.5" RadiusY="1.5" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            </Canvas>
                        </RadioButton.Tag>
                    </RadioButton>

                    <RadioButton x:Name="NavAbout" Style="{StaticResource NavItem}"
                                 Content="关于" GroupName="Nav"
                                 Checked="NavAbout_Checked">
                        <RadioButton.Tag>
                            <Canvas Width="20" Height="20">
                                <Ellipse Canvas.Left="3" Canvas.Top="3" Width="14" Height="14"
                                         Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                         StrokeThickness="1.6"/>
                                <Rectangle Canvas.Left="9.2" Canvas.Top="6.8" Width="1.6" Height="5.6" RadiusX="0.8" RadiusY="0.8"
                                           Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                <Rectangle Canvas.Left="9.2" Canvas.Top="14" Width="1.6" Height="1.6" RadiusX="0.8" RadiusY="0.8"
                                           Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            </Canvas>
                        </RadioButton.Tag>
                    </RadioButton>
                </StackPanel>

                <TextBlock Grid.Row="2" Text="v0.1.0 · WPF" FontSize="12.5" Margin="4,0,0,0"
                           Foreground="{StaticResource ColTextMuted}"/>
            </Grid>
        </Border>

        <!-- ================= 右侧内容 ================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" MinHeight="150"/>
            </Grid.RowDefinitions>

            <!-- 首次引导页（未绑定目录时显示） -->
            <Grid Grid.Row="0" x:Name="PageOnboarding" Margin="28,28,28,16" Visibility="Collapsed">
                <Border Style="{StaticResource Card}" VerticalAlignment="Center"
                        HorizontalAlignment="Stretch" Padding="32,36">
                    <StackPanel>
                        <TextBlock Text="GreenChrome 不知道你的绿色版 Chrome 放在哪里"
                                   FontSize="22" FontWeight="Bold"
                                   Foreground="{StaticResource ColText}"/>
                        <TextBlock Margin="0,12,0,0" FontSize="13.5" TextWrapping="Wrap"
                                   Foreground="{StaticResource ColTextMuted}"
                                   Text="绿色版目录可以放在磁盘任意位置。请先选择一个已有目录，或让 GreenChrome 为你制作一套新的。"/>
                        <StackPanel Orientation="Horizontal" Margin="0,28,0,0">
                            <Button x:Name="BtnPickExisting" Content="选择已有目录"
                                    Style="{StaticResource PrimaryButton}" MinWidth="130"
                                    Click="BtnPickExisting_Click"/>
                            <Button x:Name="BtnMakeFresh" Content="从零制作一套"
                                    Style="{StaticResource SecondaryButton}" MinWidth="130"
                                    Margin="12,0,0,0" Click="BtnMakeFresh_Click"/>
                        </StackPanel>

                        <!-- 从零制作的进度（只在制作过程中出现） -->
                        <StackPanel x:Name="FreshProgress" Visibility="Collapsed" Margin="0,24,0,0">
                            <Border Height="6" CornerRadius="3" Background="{StaticResource ColBorder}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition x:Name="ColFreshDone" Width="0"/>
                                        <ColumnDefinition x:Name="ColFreshRest" Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{StaticResource ColAccent}"/>
                                </Grid>
                            </Border>
                            <TextBlock x:Name="FreshStatus" Text="" FontSize="12.5" Margin="0,10,0,0"
                                       TextWrapping="Wrap" Foreground="{StaticResource ColTextMuted}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 仪表盘：三块（本机 / 线上 / 操作） -->
            <Grid Grid.Row="0" x:Name="PageDashboard" Margin="28,24,28,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 页头 -->
                <StackPanel Grid.Row="0" Margin="0,0,0,16">
                    <TextBlock Text="仪表盘" FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource ColText}"/>
                    <TextBlock Text="本机 Chrome 状态与线上最新版本" FontSize="12.5" Margin="0,4,0,0"
                               Foreground="{StaticResource ColTextMuted}"/>
                </StackPanel>

                <!-- ① 本机 CHROME ＋ ② 线上最新版本 -->
                <Grid Grid.Row="1" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ① 本机 -->
                    <Border Grid.Column="0" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="本机 CHROME" Style="{StaticResource CardTitle}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <!-- 行高比默认大一些，让左卡内容高度与右侧卡片对齐，底部不留空 -->
                                    <RowDefinition Height="40"/>
                                    <RowDefinition Height="40"/>
                                    <RowDefinition Height="44"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="版本" Style="{StaticResource KvKey}"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="LocalVersion" Text="未检测" Style="{StaticResource KvVal}"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="目录" Style="{StaticResource KvKey}"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="LocalDir" Text="" Style="{StaticResource KvVal}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="通道" Style="{StaticResource KvKey}"/>
                                <Border Grid.Row="2" Grid.Column="1" Background="#F1F2F4" CornerRadius="7"
                                        Padding="2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="ChipStable" Style="{StaticResource ChannelChip}" Content="STABLE"
                                                     Tag="stable" GroupName="Channel" Checked="ChannelChip_Checked"/>
                                        <RadioButton x:Name="ChipBeta" Style="{StaticResource ChannelChip}" Content="BETA"
                                                     Tag="beta" GroupName="Channel" Checked="ChannelChip_Checked"/>
                                        <RadioButton x:Name="ChipDev" Style="{StaticResource ChannelChip}" Content="DEV"
                                                     Tag="dev" GroupName="Channel" Checked="ChannelChip_Checked"/>
                                        <RadioButton x:Name="ChipCanary" Style="{StaticResource ChannelChip}" Content="CANARY"
                                                     Tag="canary" GroupName="Channel" Checked="ChannelChip_Checked"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,13,0,0">
                                <Button x:Name="BtnOpenDir" Content="打开文件夹" Style="{StaticResource SecondaryButton}"
                                        MinWidth="100" Padding="16,0" Click="BtnOpenDir_Click">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="打开绿色版目录" Click="BtnOpenDir_Click"/>
                                            <MenuItem Header="打开 Chrome 程序目录（App）" Click="BtnOpenAppDir_Click"/>
                                            <MenuItem Header="打开用户数据目录（Data）" Click="BtnOpenDataDir_Click"/>
                                            <Separator/>
                                            <MenuItem Header="运行 Chrome" Click="BtnRunChrome_Click"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                                <Button x:Name="BtnChangeDir" Content="更换目录" Style="{StaticResource SecondaryButton}"
                                        MinWidth="100" Padding="16,0" Margin="12,0,0,0" Click="BtnChangeDir_Click"/>
                                <Button x:Name="BtnUnbind" Content="解除绑定" Style="{StaticResource DangerButton}"
                                        MinWidth="100" Padding="16,0" Margin="12,0,0,0" Click="BtnUnbind_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ② 线上最新版本 -->
                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <StackPanel>
                            <!-- 内联内容写成一行：WPF 会把换行缩进当空白，会多出空格 -->
                            <TextBlock Style="{StaticResource CardTitle}"><Run Text="线上最新版本 · "/><Hyperlink x:Name="ApiLink" RequestNavigate="Hyperlink_RequestNavigate" ToolTip="打开版本来源"><Run Text="COI.OYK.PUB" Foreground="{StaticResource ColAccent}"/></Hyperlink></TextBlock>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="30"/>
                                    <RowDefinition Height="30"/>
                                    <RowDefinition Height="30"/>
                                    <RowDefinition Height="30"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="STABLE" Style="{StaticResource KvKey}"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="VerStable" Text="未检查" Style="{StaticResource KvVal}"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="BETA" Style="{StaticResource KvKey}"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="VerBeta" Text="未检查" Style="{StaticResource KvVal}"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="DEV" Style="{StaticResource KvKey}"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="VerDev" Text="未检查" Style="{StaticResource KvVal}"/>
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="CANARY" Style="{StaticResource KvKey}"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="VerCanary" Text="未检查" Style="{StaticResource KvVal}"/>
                            </Grid>

                            <!-- 分隔线 -->
                            <Border Height="1" Background="{StaticResource ColBorder}" Margin="0,12,0,10"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="30"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Chrome++" Style="{StaticResource KvKey}"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="LocalChromePlus" Text="未检测" Style="{StaticResource KvVal}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <Button Grid.Row="0" Grid.Column="2" x:Name="BtnCppUpdate" Content="更新 Chrome++"
                                        Visibility="Collapsed" Height="26" MinWidth="104" Padding="12,0"
                                        FontSize="11.5" Style="{StaticResource SecondaryButton}"
                                        VerticalAlignment="Center" Click="BtnCppUpdate_Click"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="ChromePlusHint" Text=""
                                           Visibility="Collapsed" FontSize="11.5" Margin="0,3,0,0"
                                           Foreground="{StaticResource ColAccent}"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ③ 版本对比与操作 -->
                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="20,18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 对比行：本机 → 线上(所选通道) -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="本机" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{StaticResource ColTextMuted}"/>
                            <TextBlock x:Name="CompareLocal" Text="未检测" FontSize="15" FontWeight="Medium"
                                       Margin="8,0,0,0" VerticalAlignment="Center"
                                       Foreground="{StaticResource ColText}"/>
                            <TextBlock Text="→" FontSize="14" Margin="14,0" VerticalAlignment="Center"
                                       Foreground="{StaticResource ColTextMuted}"/>
                            <TextBlock x:Name="CompareChannel" Text="CANARY" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{StaticResource ColTextMuted}"/>
                            <TextBlock x:Name="CompareOnline" Text="未检查" FontSize="15" FontWeight="Medium"
                                       Margin="8,0,0,0" VerticalAlignment="Center"
                                       Foreground="{StaticResource ColText}"/>
                        </StackPanel>

                        <!-- 状态 + 按钮（进度单独占一行，避免把状态文字和百分比挤掉） -->
                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Ellipse Grid.Column="0" Width="8" Height="8" VerticalAlignment="Center"
                                     x:Name="StatusDot" Fill="{StaticResource ColTextMuted}"/>
                            <TextBlock Grid.Column="1" x:Name="StatusText" Text="状态：就绪"
                                       FontSize="13" FontWeight="Medium" Margin="10,0,12,0"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource ColTextMuted}"/>
                            <StackPanel Grid.Column="2" Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="BtnCheck" Content="检查更新" Style="{StaticResource SecondaryButton}"
                                        Click="BtnCheck_Click"/>
                                <Button x:Name="BtnUpgrade" Content="立即更新" Style="{StaticResource PrimaryButton}"
                                        Margin="12,0,0,0" Click="BtnUpgrade_Click"/>
                            </StackPanel>

                            <!-- 下载进度 -->
                            <StackPanel x:Name="ProgressRow" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                        Orientation="Horizontal" Visibility="Collapsed" Margin="0,12,0,0">
                                <Border x:Name="ProgressWrap" Width="240" Height="6" CornerRadius="3"
                                        Background="{StaticResource ColBorder}" VerticalAlignment="Center">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition x:Name="ColProgressDone" Width="0"/>
                                            <ColumnDefinition x:Name="ColProgressRest" Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="{StaticResource ColAccent}"/>
                                    </Grid>
                                </Border>
                                <TextBlock x:Name="ProgressText" Text="" FontSize="11.5"
                                           Margin="12,0,0,0" MinWidth="150"
                                           VerticalAlignment="Center" Foreground="{StaticResource ColTextMuted}"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- 关于页 -->
            <Grid Grid.Row="0" x:Name="PageAbout" Margin="28,28,28,16" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,20">
                    <TextBlock Text="关于" FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource ColText}"/>
                    <TextBlock Text="GreenChrome · 绿色版 Chrome 管理工具" FontSize="12.5" Margin="0,6,0,0"
                               Foreground="{StaticResource ColTextMuted}"/>
                </StackPanel>

                <Border Grid.Row="1" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="关于 GreenChrome" Style="{StaticResource CardTitle}"/>
                        <StackPanel Margin="0,0,0,14">
                            <TextBlock FontSize="13.5" Foreground="{StaticResource ColText}" Margin="0,0,0,4" Text="把官方 Chrome 离线包，整理成可放在任意目录的绿色版："/>
                            <TextBlock FontSize="13.5" Foreground="{StaticResource ColText}" Margin="0,0,0,4" Text="· 自动检测本机绿色版版本，与线上最新版本对比；"/>
                            <TextBlock FontSize="13.5" Foreground="{StaticResource ColText}" Margin="0,0,0,4" Text="· 需要时下载、校验、解包，升级到新版本；"/>
                            <TextBlock FontSize="13.5" Foreground="{StaticResource ColText}" Margin="0,0,0,4" Text="· 所有文件同在一个目录，不写注册表、不安装、可整体移动。"/>
                            <TextBlock FontSize="13.5" Foreground="{StaticResource ColTextMuted}" Margin="0,6,0,0"><Run Text="版本来源："/><Hyperlink x:Name="ApiLinkAbout" RequestNavigate="Hyperlink_RequestNavigate"><Run Text="https://coi.oyk.pub/api" Foreground="{StaticResource ColAccent}"/></Hyperlink></TextBlock>
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="30"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="作者" Style="{StaticResource KvKey}"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="OYK（待补）" Style="{StaticResource KvVal}"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="源码" Style="{StaticResource KvKey}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="https://github.com/（待补）" Style="{StaticResource KvVal}"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="版本" Style="{StaticResource KvKey}"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="v0.1.0（WPF 版）" Style="{StaticResource KvVal}"/>
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="许可" Style="{StaticResource KvKey}"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="MIT" Style="{StaticResource KvVal}"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 运行日志 -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="28,0,28,24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="运行日志" Style="{StaticResource CardTitle}" Margin="0"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" x:Name="LogCount" Text="共 0 条" FontSize="12" Margin="10,0,0,0"
                                   VerticalAlignment="Center" Foreground="{StaticResource ColTextMuted}"/>
                        <Button Grid.Column="3" Content="清空" Height="30" MinWidth="60" Padding="12,0"
                                FontSize="12" Style="{StaticResource SecondaryButton}"
                                VerticalAlignment="Center"
                                Click="BtnClearLog_Click"/>
                    </Grid>

                    <ListBox Grid.Row="1" x:Name="LogList" BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0,0,0,6"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="12.5" TextWrapping="Wrap"
                                           Foreground="{StaticResource ColTextMuted}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
